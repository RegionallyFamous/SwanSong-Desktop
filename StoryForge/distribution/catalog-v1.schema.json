{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/RegionallyFamous/SwanSong-Desktop/main/StoryForge/distribution/catalog-v1.schema.json",
  "title": "SwanSong public homebrew catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogID",
    "revision",
    "generatedAt",
    "repositoryURL",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "catalogID": {
      "const": "regionally-famous.swansong-story-forge"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "repositoryURL": {
      "const": "https://github.com/RegionallyFamous/SwanSong-Desktop"
    },
    "entries": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "httpsURL": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "developer",
        "summary",
        "description",
        "licenseName",
        "licenseURL",
        "sourceURL",
        "provenanceURL",
        "releases"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?!.*\\.\\.)[a-z](?:[a-z0-9.-]{0,126}[a-z0-9])?$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "SwanSong additionally enforces this as a UTF-8 byte limit."
        },
        "developer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "SwanSong additionally enforces this as a UTF-8 byte limit."
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "SwanSong additionally enforces this as a UTF-8 byte limit."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "description": "SwanSong additionally enforces this as a UTF-8 byte limit."
        },
        "licenseName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "licenseURL": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/RegionallyFamous/SwanSong-Desktop/blob/[0-9a-f]{40}/[^%?#]+$"
        },
        "sourceURL": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/RegionallyFamous/SwanSong-Desktop/tree/[0-9a-f]{40}/StoryForge/games/[a-z0-9.-]+(?:/[^%?#]+)?$"
        },
        "provenanceURL": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/RegionallyFamous/SwanSong-Desktop/blob/[0-9a-f]{40}/StoryForge/games/[a-z0-9.-]+(?:/[^%?#]+)?$"
        },
        "releases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/release"
          }
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "saveCompatibilityID",
        "releasedAt",
        "releaseURL",
        "asset"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^(?!.*\\.\\.)[0-9](?:[a-z0-9+.-]{0,62}[a-z0-9])?$"
        },
        "saveCompatibilityID": {
          "type": "string",
          "pattern": "^(?!.*\\.\\.)[a-z](?:[a-z0-9.-]{0,126}[a-z0-9])?$"
        },
        "releasedAt": {
          "type": "string",
          "format": "date-time"
        },
        "releaseURL": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/RegionallyFamous/SwanSong-Desktop/releases/tag/[A-Za-z0-9._+-]+$"
        },
        "asset": {
          "$ref": "#/$defs/asset"
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "byteCount",
        "sha256",
        "fileExtension",
        "hardwareModel"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/RegionallyFamous/SwanSong-Desktop/releases/download/[A-Za-z0-9._+-]+/[A-Za-z0-9._-]+$"
        },
        "byteCount": {
          "type": "integer",
          "minimum": 65536,
          "maximum": 16777216,
          "multipleOf": 65536
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "fileExtension": {
          "enum": [
            "ws",
            "wsc",
            "pc2",
            "pcv2"
          ]
        },
        "hardwareModel": {
          "enum": [
            "wonderSwan",
            "wonderSwanColor",
            "swanCrystal",
            "pocketChallengeV2"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "hardwareModel": {
                "const": "wonderSwan"
              }
            }
          },
          "then": {
            "properties": {
              "fileExtension": {
                "const": "ws"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "hardwareModel": {
                "enum": [
                  "wonderSwanColor",
                  "swanCrystal"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "fileExtension": {
                "const": "wsc"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "hardwareModel": {
                "const": "pocketChallengeV2"
              }
            }
          },
          "then": {
            "properties": {
              "fileExtension": {
                "enum": [
                  "pc2",
                  "pcv2"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
