{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/RegionallyFamous/SwanSong-Desktop/main/StoryForge/distribution/catalog-v1.sig.schema.json",
  "title": "SwanSong detached homebrew catalog signatures v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "algorithm",
    "catalogSHA256",
    "catalogByteCount",
    "signatures"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "algorithm": { "const": "Ed25519" },
    "catalogSHA256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "catalogByteCount": { "type": "integer", "minimum": 1, "maximum": 1048576 },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyID", "signature"],
        "properties": {
          "keyID": {
            "type": "string",
            "minLength": 8,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "signature": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]{86}==$"
          }
        }
      }
    }
  }
}
