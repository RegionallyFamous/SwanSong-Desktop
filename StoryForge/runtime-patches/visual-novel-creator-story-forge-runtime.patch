+#!/usr/bin/env python3
+from __future__ import annotations
+
+import base64
+import io
+import json
+import os
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+from PIL import Image, ImageDraw
+
+
+RUNTIME_ROOT = Path(__file__).resolve().parents[1]
+CONVERTER = RUNTIME_ROOT / "tools" / "convert_json.py"
+GAME_TYPES = RUNTIME_ROOT / "src" / "game_types.h"
+RUNTIME_MAIN = RUNTIME_ROOT / "src" / "main.c"
+
+
+def png_data_url(image: Image.Image) -> str:
+    buffer = io.BytesIO()
+    image.save(buffer, format="PNG")
+    return "data:image/png;base64," + base64.b64encode(buffer.getvalue()).decode("ascii")
+
+
+def asset(asset_id: str, image: Image.Image, palette_mode: str) -> dict[str, object]:
+    return {
+        "id": asset_id,
+        "name": asset_id,
+        "dataUrl": png_data_url(image),
+        "origW": image.width,
+        "origH": image.height,
+        "origName": f"{asset_id}.png",
+        "mime": "image/png",
+        "paletteMode": palette_mode,
+    }
+
+
+def rgba_frame(color: tuple[int, int, int, int], offset: int = 0) -> Image.Image:
+    image = Image.new("RGBA", (224, 144), (0, 0, 0, 0))
+    draw = ImageDraw.Draw(image)
+    draw.rectangle((40 + offset, 16, 87 + offset, 95), fill=color)
+    return image
+
+
+def character_frame(color: tuple[int, int, int, int], offset: int = 0) -> Image.Image:
+    image = Image.new("RGBA", (96, 128), (0, 0, 0, 0))
+    draw = ImageDraw.Draw(image)
+    draw.rectangle((24 + offset, 16, 71 + offset, 119), fill=color)
+    return image
+
+
+def visual_fields() -> dict[str, object]:
+    return {
+        "bgImageId": "bg_choice",
+        "fgImageId": "fg_base",
+        "fgTalkImageId": "fg_talk",
+        "fgBlinkImageId": "fg_blink",
+        "bgPreset": "temple",
+        "bgColor": "#123456",
+        "bgColor2": "#654321",
+        "tbStyle": "royal",
+        "speakerColor": "#abcdef",
+        "charId": "char_base",
+        "charPos": "right",
+        "charAnim": "talk-blink",
+        "char2Id": "char_talk",
+        "char2Pos": "none",
+        "char3Id": "char_blink",
+        "particles": "sparks",
+        "screenFx": "sepia",
+        "transition": "flash",
+        "palCycleEnable": True,
+        "palCycleStart": 3,
+        "palCycleLen": 4,
+        "palCycleSpeed": 9,
+    }
+
+
+def make_project() -> dict[str, object]:
+    background = Image.new("RGB", (224, 144), (18, 52, 86))
+    visuals = visual_fields()
+    scene = {
+        "id": "scene",
+        "type": "scene",
+        "name": "Visual scene",
+        "speaker": "Guide",
+        "dialogue": "Choose now.",
+        "textSpeed": "normal",
+        "next": "choice",
+        "sceneFlagOps": [],
+        **visuals,
+    }
+    choice = {
+        "id": "choice",
+        "type": "choice",
+        "name": "Visual choice",
+        "prompt": "Which way?",
+        "choices": [{"text": "Forward", "target": "end", "flagOps": []}],
+        "defaultTarget": "end",
+        **visuals,
+    }
+    return {
+        "title": "Choice Visual Selftest",
+        "startNodeId": "scene",
+        "audioBackend": "legacy",
+        "flags": [],
+        "tracks": [],
+        "assets": {
+            "backgrounds": [asset("bg_choice", background, "image")],
+            "foregrounds": [
+                asset("fg_base", rgba_frame((220, 40, 60, 255)), "auto-tile"),
+                asset("fg_talk", rgba_frame((40, 220, 80, 255), 1), "auto-tile"),
+                asset("fg_blink", rgba_frame((40, 80, 220, 255), 2), "auto-tile"),
+            ],
+            "characters": [
+                asset("char_base", character_frame((220, 40, 60, 255)), "top-bottom"),
+                asset("char_talk", character_frame((40, 220, 80, 255), 1), "top-bottom"),
+                asset("char_blink", character_frame((40, 80, 220, 255), 2), "top-bottom"),
+            ],
+            "sfx": [],
+        },
+        "nodes": [scene, choice, {"id": "end", "type": "end", "name": "End"}],
+    }
+
+
+def node_block(generated: str, node_type: str, member: str) -> str:
+    pattern = re.compile(
+        rf"static const node_t __far NODE_\d+ = \{{ {node_type}, \{{ \.{member} = \{{(?P<body>.*?)\n  \}} \}} \}};",
+        re.S,
+    )
+    match = pattern.search(generated)
+    if not match:
+        raise AssertionError(f"missing generated {node_type} initializer")
+    return " ".join(match.group("body").split())
+
+
+def assert_generated_visuals(generated: str) -> None:
+    scene = node_block(generated, "NODE_SCENE", "scene")
+    choice = node_block(generated, "NODE_CHOICE", "choice")
+    expected = [
+        "0x123456UL, 0x654321UL, 0xABCDEFUL,",
+        "10, 10, 7, 5, 6, 7,",
+        "0, 0, 0, 1, 0, POS_RIGHT, 1, POS_NONE, 2,",
+        "SFX_KEEP, 0, 1, 3, 4, 9,",
+    ]
+    for fragment in expected:
+        if fragment not in scene:
+            raise AssertionError(f"scene lost visual fragment: {fragment}")
+        if fragment not in choice:
+            raise AssertionError(f"choice lost visual fragment: {fragment}")
+    if "true, { empty_str, empty_str, empty_str, empty_str," not in choice:
+        raise AssertionError("choice visual payload is not marked present")
+
+
+def assert_runtime_order() -> None:
+    source = RUNTIME_MAIN.read_text(encoding="utf-8", errors="replace")
+    start = source.index("static uint16_t run_choice")
+    end = source.index("static uint16_t run_branch", start)
+    body = source[start:end]
+    prepare = body.index("prepare_scene_visuals_with_transition(&c->visuals)")
+    draw = body.index("draw_box()")
+    if prepare >= draw:
+        raise AssertionError("choice visuals are not prepared before choice drawing")
+    scene_start = source.index("static uint16_t run_scene")
+    scene_end = source.index("static uint16_t run_investigation", scene_start)
+    if "prepare_scene_visuals_with_transition(s)" not in source[scene_start:scene_end]:
+        raise AssertionError("scene and choice entry do not share the visual helper")
+
+
+def assert_transition_continuity() -> None:
+    source = RUNTIME_MAIN.read_text(encoding="utf-8", errors="replace")
+    if "#define TRANSITION_FADE_LEVELS 15" not in source:
+        raise AssertionError("fade does not traverse all 15 RGB444 brightness levels")
+    if "#define TRANSITION_BLACK_HOLD_FRAMES 2" not in source:
+        raise AssertionError("fade does not retain a stable black scene-swap hold")
+    if "#define BLINK_INTERVAL_FRAMES 210" not in source:
+        raise AssertionError("eye blink cadence is too frequent or stale")
+    if "#define BLINK_CLOSED_FRAMES     8" not in source:
+        raise AssertionError("eye blink is not using the readable closed-eye dwell")
+
+    start = source.index("static void prepare_scene_visuals_with_transition")
+    end = source.index("SAVE / LOAD OVERLAY", start)
+    body = source[start:end]
+    ordered = [
+        "transition_fade_to_black(TRANSITION_FADE_LEVELS)",
+        "outportb(IO_DISPLAY_CTRL, 0)",
+        "prepare_scene_visuals(s)",
+        "pal_snapshot(g_trans_pal)",
+        "pal_apply_scaled(g_trans_pal, 0, 1)",
+        "outportb(IO_DISPLAY_CTRL, DISPLAY_SCR1_ENABLE|DISPLAY_SCR2_ENABLE)",
+        "transition_hold_black(TRANSITION_BLACK_HOLD_FRAMES)",
+        "transition_fade_from_black(TRANSITION_FADE_LEVELS)",
+    ]
+    positions = [body.index(fragment) for fragment in ordered]
+    if positions != sorted(positions):
+        raise AssertionError("scene swap is not fully hidden between fade-out and fade-in")
+    if "transition_fade_to_black(8)" in body or "transition_fade_from_black(8)" in body:
+        raise AssertionError("legacy eight-frame hard fade is still active")
+
+
+def assert_pause_animation_lifecycle() -> None:
+    source = RUNTIME_MAIN.read_text(encoding="utf-8", errors="replace")
+    show_start = source.index("static const char __far *show_text_block")
+    show_end = source.index("static void do_ops", show_start)
+    show_body = source[show_start:show_end]
+    if show_body.index("char_talk_begin();") >= show_body.index("draw_box();"):
+        raise AssertionError("talk frame is not restored before a continued text block is drawn")
+
+    finish_start = source.index("static void char_talk_finish")
+    finish_end = source.index("static void draw_box", finish_start)
+    finish_body = source[finish_start:finish_end]
+    if "if (g_talk_enabled && g_talk_blink_id" not in finish_body:
+        raise AssertionError("pause pages do not enable the blink frame")
+    if "final_page && g_talk_enabled" in finish_body:
+        raise AssertionError("blink activation is still restricted to the final dialogue page")
+    if "g_talk_frame_id = s->char2_id;" not in source:
+        raise AssertionError("talk frame ID is not retained for post-pause restoration")
+
+
+def assert_legacy_initializer_builds(temp_dir: Path) -> None:
+    compiler = shutil.which(os.environ.get("CC", "cc"))
+    if not compiler:
+        raise AssertionError("no host C compiler found for legacy initializer proof")
+    source = temp_dir / "legacy_choice.c"
+    binary = temp_dir / "legacy_choice"
+    source.write_text(
+        "#define __far\n"
+        "#include <stddef.h>\n"
+        "#include \"game_types.h\"\n"
+        "static const choice_node_t legacy = { \"Prompt\", 0, NULL, 0xFFFF };\n"
+        "int main(void) { return legacy.has_visuals ? 1 : 0; }\n",
+        encoding="ascii",
+    )
+    subprocess.run(
+        [
+            compiler,
+            "-std=c11",
+            "-Wall",
+            "-Wextra",
+            "-Werror",
+            "-Wno-missing-field-initializers",
+            "-I",
+            str(GAME_TYPES.parent),
+            str(source),
+            "-o",
+            str(binary),
+        ],
+        check=True,
+    )
+    subprocess.run([str(binary)], check=True)
+
+
+def main() -> int:
+    with tempfile.TemporaryDirectory(prefix="wscvn-choice-visuals-") as temp:
+        temp_dir = Path(temp)
+        project_path = temp_dir / "choice-visuals.wscvn.json"
+        output_dir = temp_dir / "generated"
+        project_path.write_text(json.dumps(make_project()), encoding="utf-8")
+        env = dict(os.environ)
+        env["PYTHONDONTWRITEBYTECODE"] = "1"
+        subprocess.run(
+            [sys.executable, str(CONVERTER), str(project_path), str(output_dir)],
+            check=True,
+            env=env,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+        )
+        generated = (output_dir / "game_data.c").read_text(encoding="utf-8")
+        assert_generated_visuals(generated)
+        assert_runtime_order()
+        assert_transition_continuity()
+        assert_pause_animation_lifecycle()
+        assert_legacy_initializer_builds(temp_dir)
+    print("choice visual selftest: ok")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
